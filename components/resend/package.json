{
  "name": "@bunvex/resend",
  "version": "0.1.0",
  "description": "An email component for bunvex: emails queued, batched and sent to Resend's API with retries and rate limiting, delivery statuses from Resend's signed webhooks, an onEmailEvent callback, cancelation and cleanups.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "bunvex",
    "component",
    "resend",
    "email"
  ],
  "exports": {
    ".": "./src/client/index.ts",
    "./bunvex.config": {
      "@bunvex/component-source": "./src/component/bunvex.config.ts",
      "bunvex": "./src/component/bunvex.config.ts",
      "default": "./src/component/bunvex.config.ts"
    },
    "./bunvex.config.js": {
      "@bunvex/component-source": "./src/component/bunvex.config.ts",
      "bunvex": "./src/component/bunvex.config.ts",
      "default": "./src/component/bunvex.config.ts"
    },
    "./_generated/component.js": {
      "types": "./src/component/_generated/component.ts"
    },
    "./test": "./src/test.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@bunvex/server": "workspace:^",
    "@bunvex/values": "workspace:^"
  },
  "dependencies": {
    "@bunvex/helpers": "workspace:^",
    "@bunvex/rate-limiter": "workspace:^",
    "@bunvex/workpool": "workspace:^"
  },
  "devDependencies": {
    "@bunvex/testing": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunvex/bunvex",
    "directory": "components/resend"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  }
}
