{
  "name": "@bunvex/sharded-counter",
  "version": "0.1.0",
  "description": "A sharded counter component for bunvex: counts that many mutations update at once without conflicts.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "bunvex",
    "component",
    "count",
    "counter"
  ],
  "exports": {
    ".": "./src/client/index.ts",
    "./bunvex.config": {
      "@bunvex/component-source": "./src/component/bunvex.config.ts",
      "bunvex": "./src/component/bunvex.config.ts",
      "default": "./src/component/bunvex.config.ts"
    },
    "./bunvex.config.js": {
      "@bunvex/component-source": "./src/component/bunvex.config.ts",
      "bunvex": "./src/component/bunvex.config.ts",
      "default": "./src/component/bunvex.config.ts"
    },
    "./_generated/component.js": {
      "types": "./src/component/_generated/component.ts"
    },
    "./test": "./src/test.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@bunvex/server": "workspace:^",
    "@bunvex/values": "workspace:^"
  },
  "devDependencies": {
    "@bunvex/helpers": "workspace:*",
    "@bunvex/testing": "workspace:*",
    "fast-check": "4.10.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunvex/bunvex",
    "directory": "components/sharded-counter"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  }
}
