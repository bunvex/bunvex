{
  "name": "bunvex-example-react-native",
  "version": "0.0.0",
  "private": true,
  "description": "A chat with Expo on iOS, Android and the web: the same query and mutation as the tutorial, through @bunvex/react on React Native.",
  "main": "index.ts",
  "scripts": {
    "dev": "bunvex dev --start 'expo start --clear'",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build": "tsc --noEmit && expo export --platform all --no-bytecode --output-dir dist"
  },
  "dependencies": {
    "@bunvex/react": "workspace:*",
    "@bunvex/server": "workspace:*",
    "@bunvex/values": "workspace:*",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.21",
    "expo-device-hub": "^0.19.0",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@bunvex/cli": "workspace:*",
    "@types/react": "~19.3.0",
    "bunvex-examples-harness": "workspace:*",
    "typescript": "~7.0.2"
  }
}
