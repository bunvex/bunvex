{
  "name": "bunvex",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A Convex-style reactive backend for Bun, with its own database engine on pluggable persistence.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./values": "./src/values.ts",
    "./browser": "./src/browser.ts",
    "./react": "./src/react.ts",
    "./nextjs": "./src/nextjs.ts",
    "./react-clerk": "./src/react-clerk.ts",
    "./react-auth0": "./src/react-auth0.ts"
  },
  "dependencies": {
    "@bunvex/server": "workspace:*",
    "@bunvex/values": "workspace:*",
    "@bunvex/client": "workspace:*",
    "@bunvex/react": "workspace:*",
    "@bunvex/nextjs": "workspace:*",
    "@bunvex/react-clerk": "workspace:*",
    "@bunvex/react-auth0": "workspace:*",
    "@bunvex/cli": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "@auth0/auth0-react": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@auth0/auth0-react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunvex/bunvex",
    "directory": "packages/bunvex"
  },
  "bin": {
    "bunvex": "./bin/bunvex.ts"
  },
  "devDependencies": {
    "@bunvex/core": "workspace:*",
    "@bunvex/persistence": "workspace:*",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.4",
    "postgres": "^3.4.9"
  }
}
