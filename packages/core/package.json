{
  "name": "@bunvex/core",
  "version": "0.1.0-alpha.1",
  "description": "The bunvex engine: MVCC, the committer, optimistic transactions, the query cache, subscriptions, and the Persistence contract with its zero-dependency drivers (memory, SQLite).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./persistence": "./src/persistence/index.ts",
    "./persistence/memory": "./src/persistence/memory.ts",
    "./persistence/sqlite": "./src/persistence/sqlite.ts",
    "./test-runtime": "./src/test-runtime.ts"
  },
  "dependencies": {
    "@bunvex/values": "workspace:*",
    "sorted-btree": "^2.1.0",
    "@bunvex/search": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunvex/bunvex",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
