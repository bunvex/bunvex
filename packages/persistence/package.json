{
  "name": "@bunvex/persistence",
  "version": "0.1.0-alpha.2",
  "description": "External persistence drivers for the bunvex engine: Postgres and MySQL. Install only the native driver you use.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./postgres": "./src/postgres.ts",
    "./mysql": "./src/mysql.ts"
  },
  "dependencies": {
    "@bunvex/core": "workspace:*"
  },
  "peerDependencies": {
    "mysql2": ">=3",
    "postgres": ">=3.4"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "mysql2": "^3.24.4",
    "postgres": "^3.4.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunvex/bunvex",
    "directory": "packages/persistence"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  }
}
