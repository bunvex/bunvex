{
  "create": [
    "CREATE TABLE `documents` (\n  `id` binary(16) NOT NULL,\n  `ts` bigint NOT NULL,\n  `table_id` binary(16) NOT NULL,\n  `json_value` longblob NOT NULL,\n  `deleted` tinyint(1) DEFAULT '0',\n  `prev_ts` bigint DEFAULT NULL,\n  PRIMARY KEY (`ts`,`table_id`,`id`),\n  KEY `documents_by_table_and_id` (`table_id`,`id`,`ts`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC",
    "CREATE TABLE `indexes` (\n  `index_id` binary(16) NOT NULL,\n  `ts` bigint NOT NULL,\n  `key_prefix` varbinary(2500) NOT NULL,\n  `key_suffix` longblob,\n  `key_sha256` binary(32) NOT NULL,\n  `deleted` tinyint(1) DEFAULT NULL,\n  `table_id` binary(16) DEFAULT NULL,\n  `document_id` binary(16) DEFAULT NULL,\n  PRIMARY KEY (`index_id`,`key_prefix`,`key_sha256`,`ts`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC",
    "CREATE TABLE `leases` (\n  `id` bigint NOT NULL,\n  `ts` bigint NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC",
    "CREATE TABLE `persistence_globals` (\n  `key` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin NOT NULL,\n  `json_value` longblob NOT NULL,\n  PRIMARY KEY (`key`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC",
    "CREATE TABLE `read_only` (\n  `id` bigint NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC"
  ],
