{
  "name": "@bunvex/server",
  "version": "0.1.0-alpha.0",
  "description": "The bunvex server: function runtime, HTTP API, WebSocket sync, configuration.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/isomorphic.ts"
    }
  },
  "dependencies": {
    "@bunvex/auth": "workspace:*",
    "@bunvex/core": "workspace:*",
    "@bunvex/file-storage": "workspace:*",
    "@bunvex/protocol": "workspace:*",
    "@bunvex/values": "workspace:*",
    "@types/object-inspect": "^1.13.0",
    "object-inspect": "^1.13.4"
  },
  "peerDependencies": {
    "@bunvex/persistence": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@bunvex/persistence": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bunvex/persistence": "workspace:*",
    "jose": "^6.2.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bunvex/bunvex",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  }
}
