{
  "extends": "./tsconfig.base.json",
  "include": ["packages/*/src", "packages/*/test", "packages/sync-e2e/node/*.ts", "bench", "scripts"],
  // The UI packages need DOM types and JSX, which the engine and server must not see: own tsconfigs (UI-01 §8).
  "exclude": [
    "packages/ui",
    "packages/dashboard",
    "packages/dashboard-source",
    "packages/sync-e2e/dashboard",
    "packages/react",
    "packages/react-clerk",
    "packages/react-auth0"
  ]
}
