{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src",
    "packages/*/test",
    "components/*/src",
    "components/*/test",
    "packages/sync-e2e/node/*.ts",
    "bench",
    "scripts"
  ],
  // The UI packages need DOM types and JSX, which the engine and server must not see: own tsconfigs (UI-01 §8).
  "exclude": [
    "packages/ui",
    "packages/dashboard",
    "packages/dashboard-source",
    "packages/sync-e2e/dashboard",
    "packages/react",
    "packages/react-clerk",
    "packages/react-auth0",
    // @bunvex/auth's clients: their own tsconfig, with DOM types.
    "components/auth/src/browser",
    "components/auth/src/methods/oauth",
    "components/auth/src/react",
    "components/auth/src/methods/username-password/react.tsx",
    "components/auth/src/methods/anonymous/react.tsx"
  ]
}
